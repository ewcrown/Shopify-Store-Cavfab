            <path d="M14.6866 28.7624C15.9002 28.7624 16.8839 27.7786 16.8839 26.565C16.8839 25.3515 15.9002 24.3677 14.6866 24.3677C13.473 24.3677 12.4893 25.3515 12.4893 26.565C12.4893 27.7786 13.473 28.7624 14.6866 28.7624Z" fill="white"/>
            <path d="M24.0333 28.7624C25.2468 28.7624 26.2306 27.7786 26.2306 26.565C26.2306 25.3515 25.2468 24.3677 24.0333 24.3677C22.8197 24.3677 21.8359 25.3515 21.8359 26.565C21.8359 27.7786 22.8197 28.7624 24.0333 28.7624Z" fill="white"/>
            </g>
            <defs>
            <clipPath id="clip0_1_6652">
            <rect width="35" height="35" fill="white"/>
            </clipPath>
            </defs>
            </svg>
        {%- elsif settings.cart_icon == 'bag-minimal' -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 35 35" fill="none">
<g clip-path="url(#clip0_1_6652)">
<path d="M17.5 35C27.165 35 35 27.165 35 17.5C35 7.83502 27.165 0 17.5 0C7.83502 0 0 7.83502 0 17.5C0 27.165 7.83502 35 17.5 35Z" fill="#CA4E28"/>
<path d="M13.6318 15.8943L11.8468 9.94755H7.78027V8.42505H12.9712L15.0865 15.448L13.6318 15.8943Z" fill="white"/>
<path d="M27.0137 16.1023L24.5998 21.3282H13.7137L12.1857 16.1023H27.0137ZM29.4079 14.571H10.1426L12.5663 22.8595H25.5798L29.4079 14.571Z" fill="white"/>
<path d="M14.6866 28.7624C15.9002 28.7624 16.8839 27.7786 16.8839 26.565C16.8839 25.3515 15.9002 24.3677 14.6866 24.3677C13.473 24.3677 12.4893 25.3515 12.4893 26.565C12.4893 27.7786 13.473 28.7624 14.6866 28.7624Z" fill="white"/>
<path d="M24.0333 28.7624C25.2468 28.7624 26.2306 27.7786 26.2306 26.565C26.2306 25.3515 25.2468 24.3677 24.0333 24.3677C22.8197 24.3677 21.8359 25.3515 21.8359 26.565C21.8359 27.7786 22.8197 28.7624 24.0333 28.7624Z" fill="white"/>
</g>
<defs>
<clipPath id="clip0_1_6652">
<rect width="35" height="35" fill="white"/>
</clipPath>
</defs>
</svg>
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 35 35" fill="none">
<g clip-path="url(#clip0_1_6652)">
<path d="M17.5 35C27.165 35 35 27.165 35 17.5C35 7.83502 27.165 0 17.5 0C7.83502 0 0 7.83502 0 17.5C0 27.165 7.83502 35 17.5 35Z" fill="#CA4E28"/>
<path d="M13.6318 15.8943L11.8468 9.94755H7.78027V8.42505H12.9712L15.0865 15.448L13.6318 15.8943Z" fill="white"/>
<path d="M27.0137 16.1023L24.5998 21.3282H13.7137L12.1857 16.1023H27.0137ZM29.4079 14.571H10.1426L12.5663 22.8595H25.5798L29.4079 14.571Z" fill="white"/>
<path d="M14.6866 28.7624C15.9002 28.7624 16.8839 27.7786 16.8839 26.565C16.8839 25.3515 15.9002 24.3677 14.6866 24.3677C13.473 24.3677 12.4893 25.3515 12.4893 26.565C12.4893 27.7786 13.473 28.7624 14.6866 28.7624Z" fill="white"/>
<path d="M24.0333 28.7624C25.2468 28.7624 26.2306 27.7786 26.2306 26.565C26.2306 25.3515 25.2468 24.3677 24.0333 24.3677C22.8197 24.3677 21.8359 25.3515 21.8359 26.565C21.8359 27.7786 22.8197 28.7624 24.0333 28.7624Z" fill="white"/>
</g>
<defs>
<clipPath id="clip0_1_6652">
<rect width="35" height="35" fill="white"/>
</clipPath>
</defs>
</svg>
        {%- endif -%}
        <span class="icon__fallback-text">{{ 'layout.cart.title' | t }}</span>
        <span class="cart-link__bubble{% if cart.item_count > 0 %} cart-link__bubble--visible{% endif %}"></span>
      </span>
    </a>
  </div>
</div>
